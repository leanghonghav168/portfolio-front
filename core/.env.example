# Portfolio Core Backend Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL Connection (Individual parameters)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=portfolio_db
DB_SYNC=true
DB_SSL=false

# Or PostgreSQL Connection String (Overrides individual parameters if set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db

# NestJS Observe (Optional Telemetry)
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET

