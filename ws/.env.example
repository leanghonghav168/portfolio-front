# Nuxt Frontend Environment Configuration Example

# Base URL for the NestJS backend API (Core)
NUXT_PUBLIC_API_BASE=http://localhost:3001/api

# Site & SEO configuration
NUXT_PUBLIC_SITE_URL=https://portfolio.leanghonghav.site
NUXT_PUBLIC_AUTHOR="Leang Honghav"
NUXT_PUBLIC_TITLE="Leang Honghav | Lead Product Designer & Full-Stack UI Developer"

# Server configuration
NITRO_PORT=3003
NITRO_HOST=localhost
